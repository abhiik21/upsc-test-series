# Copy this file to  deployment/.env  and fill in real values.  Never commit the real file.

# ---- Required ---------------------------------------------------------------
# Random secret used to sign login tokens (at least 32 characters). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=
# The public address of your website, exactly as people type it (no trailing slash)
CORS_ORIGINS=https://your-domain.example

# The first administrator. Used only on the very first start (when no admin exists yet).
ADMIN_EMAIL=
ADMIN_PASSWORD=          # at least 12 characters
ADMIN_NAME=Admin

# ---- Sign-up e-mails ----------------------------------------------------------
# With verification on (recommended) students must confirm their e-mail, so SMTP must work.
# If you are not ready with SMTP yet, set AUTH_REQUIRE_VERIFICATION=false.
AUTH_REQUIRE_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# ---- Payments (Razorpay) -----------------------------------------------------------
# Start with TEST keys (rzp_test_...), try a full purchase, then switch to live keys. See deployment/README.md, section 5.
# With PAYMENT_PROVIDER=development checkout is switched off in production.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A long random string of your choice; enter the same value when you create the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional -------------------------------------------------------------------
# WEB_BIND=127.0.0.1     # 127.0.0.1 = reachable only through your HTTPS proxy; 0.0.0.0 = open on port 8080
# SEED_DEMO_DATA=false   # true adds sample questions/tests/users (staging copies only, never a real site)
# LOG_LEVEL=INFO
