# Production environment template — do not commit real secrets.
APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=https://your-domain.example

# First administrator (used only when no admin exists yet; at least 12 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
# Sample content is never added in production unless you set this (staging only)
SEED_DEMO_DATA=false

# PostgreSQL production target.
DB_BACKEND=postgres
DATABASE_URL=postgresql://upsc_user:change-me@postgres:5432/upsc

# Payment provider: 'razorpay' (all three RAZORPAY_* values are then required). 'development' keeps checkout off in production.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional external services
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Authentication / OTP
AUTH_REQUIRE_VERIFICATION=true
OTP_TTL_MINUTES=10
DEV_SHOW_OTP=false

# Email delivery
SMTP_TLS=true

# Object storage: local or s3
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_REGION=ap-south-1
MAX_UPLOAD_MB=25
LOCAL_STORAGE_ROOT=./data/uploads
